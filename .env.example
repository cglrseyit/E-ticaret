# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values for your environment.
#   cp .env.example .env
# ----------------------------------------------------------------------------

# ---- Database -------------------------------------------------------------
# Local dev uses SQLite (zero-setup). Production: PostgreSQL.
#   sqlite (default):  DATABASE_URL="file:./dev.db"
#   Railway/Neon:      DATABASE_URL="postgresql://USER:PASS@HOST:5432/DB?sslmode=require"
DATABASE_URL="file:./dev.db"

# ---- Site -----------------------------------------------------------------
# Used for absolute URLs in metadata, sitemap, robots and PayTR callbacks.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Auth (admin) ---------------------------------------------------------
# Long random string used to sign admin JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string"

# ---- Payment provider -----------------------------------------------------
# "mock" for local development (always succeeds), "paytr" for production.
PAYMENT_PROVIDER="mock"

# PayTR merchant credentials (only used when PAYMENT_PROVIDER="paytr").
# Get these from https://www.paytr.com after your merchant agreement is approved.
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""
# Set to "1" for PayTR sandbox/test transactions, "0" or unset for live.
PAYTR_TEST_MODE="0"

# ---- E-mail (optional) ----------------------------------------------------
# SMTP credentials for order confirmation & abandoned-cart reminders.
# Leave blank in development — `lib/email.ts` logs to the console instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Mağaza <no-reply@example.com>"
